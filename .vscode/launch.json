{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GWeb",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/cmd/gweb.go",
            "env": {
              "CGO_ENABLED": "1",
              "CGO_CFLAGS": "-I${workspaceFolder}/third_party",
              "CGO_LDFLAGS": "-L/usr/local/lib"
            },
            "args": []
        }
    ]
}